	SELECT 
	COUNT(*) AS total_rows
	FROM Metro_Interstate_Traffic_Volume;
</sql><sql name="Task 1.1: Display first 5 rows">-- Display first 5 rows 
	SELECT * 
	FROM Metro_Interstate_Traffic_Volume 
	LIMIT 5;</sql><sql name="Task 1.2 Analyse yearly traffic volume">-- Analyse yearly traffic DATABASE
WITH yearly AS (
    SELECT 
        CAST(strftime('%Y', date_time) AS INTEGER) AS year,
        SUM(traffic_volume) AS total_traffic
    FROM Metro_Interstate_Traffic_Volume
    WHERE CAST(strftime('%Y', date_time) AS INTEGER) BETWEEN 2012 AND 2017
    GROUP BY year
)
SELECT
    year,
    total_traffic,
    total_traffic - LAG(total_traffic) OVER (ORDER BY year) AS change,
    ROUND(
        100.0 * (total_traffic - LAG(total_traffic) OVER (ORDER BY year))
        / LAG(total_traffic) OVER (ORDER BY year),
        2
    ) AS percentage_change
FROM yearly
ORDER BY year;
--See word document attachement for observation.</sql><sql name="Task 1.3 Analyse temperature around holidays*"> SELECT
    holiday,
    CAST(strftime('%Y', date_time) AS INTEGER) AS year,
    ROUND(AVG(temp), 2) AS avg_temperature_K
FROM Metro_Interstate_Traffic_Volume
WHERE holiday IN ('New Years Day', 'Labor Day')
  AND CAST(strftime('%Y', date_time) AS INTEGER) BETWEEN 2015 AND 2017
GROUP BY holiday, year
ORDER BY holiday, year;</sql><current_tab id="3"/></tab_sql></sqlb_project>
